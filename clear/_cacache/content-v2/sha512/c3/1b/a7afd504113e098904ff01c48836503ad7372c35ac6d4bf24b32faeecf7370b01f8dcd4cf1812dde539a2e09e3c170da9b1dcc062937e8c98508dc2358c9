(\"Operation canceled.\");\r\n\r\n        const child = fork(\"worker.js\");\r\n        const subscription = cancelSignal.subscribe(() => {\r\n            // cancellation requested, abort worker\r\n            worker.kill();\r\n            reject(new Error(\"Operation canceled.\"));\r\n        });\r\n\r\n        worker.on(\"exit\", () => {\r\n            subscription.unsubscribe();\r\n            resolve();\r\n        });\r\n    });\r\n}\r\n```\r\n\r\n# API\r\n\r\nYou can read more about the API [here](https://esfx.js.org/esfx/api/cancelable.html).\r\n","readmeFilename":"README.md","homepage":"https://github.com/esfx/esfx#readme","_id":"@esfx/cancelable@1.0.0-prenative.1","_nodeVersion":"16.17.0","_npmVersion":"lerna/3.22.1/node@v16.17.0+x64 (linux)","dist":{"integrity":"sha512-OcGr2MMno8ncftIULAXm/eOC3NqGBgHw5J7Zhz8cxhZvZPdICImJ0jxpo1Zzgoomn02dCs43SP5R4eL+8AOe4A==","shasum":"124ba62fadd304f36fc17c90cccb3b4576c4ed97","tarball":"https://registry.npmjs.org/@esfx/cancelable/-/cancelable-1.0.0-prenative.1.tgz","fileCount":10,"unpackedSize":69341,"signatures":[{"keyid":"SHA256:jl3bwswu80PjjokCgh0o2w5c2U4LhQAE57gj9cz1kzA","sig":"MEQCIFB+MwYrx67GncMk/26k5w/kyI4LjMCsRnZdiekPWYnzAiAK6aaB2qwmR2HduhGDRExFRARXbyqIpdvlZ0koOa13sg=="}],"npm-signature":"-----BEGIN PGP SIGNATURE-----\r\nVersion: OpenPGP.js v4.10.10\r\nComment: https://openpgpjs.org\r\n\r\nwsFzBAEBCAAGBQJjJY4kACEJED1NWxICdlZqFiEECWMYAoorWMhJKdjhPU1b\r\nEgJ2VmrzJBAAljeYxKDcLJEGnuf3zjyFuZeFIjzQ+OBESUOmGfsX1DCkdrVA\r\nvfvyfDQb/8WNbWMYcZx9bFKb+RbyVH36s6dbYzNXKLlEJLAy7S2SMbGql2Ge\r\nXzK5BLyIw5zW3LHKffKawFwz+DyD+jPkEw4cablWYFED7vFBriyfLQbgJ8ZG\r\ndJ+xDCj973MkJ9KlBPN1rfVwXxH/oWAqrD45YBe7n7j+HzOhyTl/rXytVMkO\r\nNwNygbz+uHTJ0FkbHEk2dhlFNvXtJNWQTIznE+386Coze2ALhFfSwXlsBCYJ\r\nu8+ux6gndSeyLKOThJSRO+T8YDWoQsajkUm+2WQDhGCAJ2liaPeOfWovkesm\r\nFq4k/A+vTvFJCEhgNJC/hDBApM5Wg9QmFziKYgMes9wTzDCUfizZUhG8SGcq\r\nqMadWold+/8DGJXiurgzh9b+31+SA4+shmxc71Eudb6rTdYZKrYOMpdYCcoV\r\nQKaEOQgg8M2swCyQkO9HEE65ajTL0ERl7qMvH3n1LfGe1WOZbLxNyla1aZVk\r\